# Mimir local supervisor systemd unit.
# Install:
#   sudo cp scripts/mimir.service /etc/systemd/system/mimir.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mimir
# Set User and WorkingDirectory to the operating user and the repo checkout.
# If the database unit is called mariadb.service on this box, change both mysql.service references.
[Unit]
Description=Mimir academic supervisor (main, poller, GUI)
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=forking
User=mimir
WorkingDirectory=/home/mimir/mimir
ExecStart=/home/mimir/mimir/scripts/startup.sh
ExecStop=/home/mimir/mimir/scripts/shutdown.sh
PIDFile=/home/mimir/mimir/run/main.pid
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
