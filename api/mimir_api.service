# Mimir API (FastAPI + uvicorn) systemd unit.
# Install:
#   sudo cp mimir_api.service /etc/systemd/system/mimir_api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mimir_api
# Adjust User, Group, WorkingDirectory, and the venv path below to match the box.
[Unit]
Description=Mimir snapshot API and dashboard
After=network.target
Before=mimir.service

[Service]
Type=simple
User=lucaguiga
Group=lucaguiga
WorkingDirectory=/home/lucaguiga/Desktop/School/Projects/Mimir_timeManagement/api
ExecStart=/home/lucaguiga/Desktop/School/Projects/Mimir_timeManagement/venv/bin/uvicorn fastapi_app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
